{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Read(./.env.*)",
      "Edit(./.env.*)",
      "Read(./**/.env)",
      "Edit(./**/.env)",
      "Read(./**/.env.*)",
      "Edit(./**/.env.*)",
      "Read(./**/*.pem)",
      "Edit(./**/*.pem)",
      "Read(./**/*.key)",
      "Edit(./**/*.key)",
      "Read(./**/*.p12)",
      "Edit(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Edit(./**/*.pfx)",
      "Read(./**/*.jks)",
      "Edit(./**/*.jks)",
      "Read(./**/*.keystore)",
      "Edit(./**/*.keystore)",
      "Read(./**/id_rsa*)",
      "Edit(./**/id_rsa*)",
      "Read(./**/id_ed25519*)",
      "Edit(./**/id_ed25519*)",
      "Read(./**/id_ecdsa*)",
      "Edit(./**/id_ecdsa*)",
      "Read(./**/.netrc)",
      "Edit(./**/.netrc)",
      "Read(./**/.pypirc)",
      "Edit(./**/.pypirc)",
      "Read(./**/.npmrc)",
      "Edit(./**/.npmrc)",
      "Read(./**/.git-credentials)",
      "Edit(./**/.git-credentials)",
      "Read(./**/secrets/**)",
      "Edit(./**/secrets/**)",
      "Read(./**/credentials/**)",
      "Edit(./**/credentials/**)",
      "Read(./**/*secret*.json)",
      "Edit(./**/*secret*.json)",
      "Read(./**/*secret*.y*ml)",
      "Edit(./**/*secret*.y*ml)",
      "Read(./**/*credentials*.json)",
      "Edit(./**/*credentials*.json)",
      "Read(./**/*.tfvars)",
      "Edit(./**/*.tfvars)",
      "Read(./**/*.tfstate)",
      "Edit(./**/*.tfstate)"
    ]
  }
}